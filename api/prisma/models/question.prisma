enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
}

enum PointsMode {
  STANDARD
  DOUBLE_POINTS
  NO_POINTS
}

model Question {
  id          String       @id @default(uuid())
  title       String       @default("")
  type        QuestionType @default(MULTIPLE_CHOICE)
  points      PointsMode   @default(STANDARD)
  timeLimitMs Int          @default(20000)
  order       Int          @default(0)
  image       String?
  metadata    Json

  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quizId])
}
